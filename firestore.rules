rules_version = '2';

// ============================================================================
// 移行期間用のルール
//
// 新しい方式の画面（友達・トーク一覧・ホーム）と、まだ古い方式の画面
// （トーク画面・プロフィール詳細など）の両方が動くようにしている。
// 「⚠️ 移行用」と書いた部分は、全画面の移行とデータ移行が終わったら削除する。
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // 共通の関数
    // ------------------------------------------------------------------------
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function blockPath(uid, peer) {
      return /databases/$(database)/documents/users/$(uid)/blocks/$(peer);
    }
    function roomPath(roomId) {
      return /databases/$(database)/documents/chat_rooms/$(roomId);
    }

    // 運営アカウントか（Auth のカスタムクレーム admin、または users.isAdmin == true）
    // ※ isAdmin は下のルールでクライアントから書き換え不可にしている
    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true
        || get(userPath(request.auth.uid)).data.get('isAdmin', false) == true
      );
    }

    // クライアントから絶対に書き換えさせないフィールド
    // （plan は購入レシートをサーバーで検証してから書き込むこと）
    function serverOnlyFields() {
      return ['plan', 'planExpiresAt', 'role', 'isAdmin', 'isBanned'];
    }

    // ⚠️ 移行用：他人のドキュメントの配列に対して
    //    「自分のIDを追加・削除する」以外の変更をしていないか
    function onlyToggledSelf(field) {
      let before = resource.data.get(field, []).toSet();
      let after = request.resource.data.get(field, []).toSet();
      return before.difference(after).union(after.difference(before))
        .hasOnly([request.auth.uid]);
    }

    // チャットルームID（uid_uid）に自分が含まれているか
    function isRoomMember(roomId) {
      return signedIn() && request.auth.uid in roomId.split('_');
    }

    // ------------------------------------------------------------------------
    // users
    // ------------------------------------------------------------------------
    match /users/{uid} {
      allow read: if signedIn();

      // 新規登録：plan は 'free' のみ許可。運営用の項目は書かせない
      allow create: if isSelf(uid)
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
        && !request.resource.data.keys().hasAny(['planExpiresAt', 'role', 'isAdmin', 'isBanned']);

      // 自分のプロフィール更新：plan や運営用の項目は変更不可
      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyFields());

      // ⚠️ 移行用：古い方式の画面が、相手の likedBy / footprints / blockedBy に
      //    自分のIDを追加・削除できるようにする（自分のID以外は触れない）
      allow update: if signedIn() && !isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likedBy', 'footprints', 'blockedBy'])
        && onlyToggledSelf('likedBy')
        && onlyToggledSelf('footprints')
        && onlyToggledSelf('blockedBy');

      allow delete: if false;

      // 本人だけが読める。書き込みは Cloud Functions のみ
      match /friends/{peerId} { allow read: if isSelf(uid); allow write: if false; }
      match /likes/{peerId}   { allow read: if isSelf(uid); allow write: if false; }
      match /blocks/{peerId}  { allow read: if isSelf(uid); allow write: if false; }

      // 課金で制限する情報・ブロックされた情報は本人にも直接は読ませない
      match /likedBy/{peerId}    { allow read, write: if false; }
      match /footprints/{peerId} { allow read, write: if false; }
      match /blockedBy/{peerId}  { allow read, write: if false; }

      match /private/{docId} { allow read, write: if isSelf(uid); }
    }

    // ------------------------------------------------------------------------
    // chat_rooms（トークルーム）
    // ------------------------------------------------------------------------
    match /chat_rooms/{roomId} {
      // 1件取得：ルームIDに自分が含まれていれば可（まだ存在しないルームの確認も含む）
      allow get: if isRoomMember(roomId);
      // 一覧取得：where('users', arrayContains: 自分) の検索のみ
      allow list: if signedIn() && request.auth.uid in resource.data.users;

      // 作成：2人だけのルームで、IDが「uid_uid」の形、
      //       どちらかがブロックしている相手とは作れない
      allow create: if isRoomMember(roomId)
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && (roomId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
            || roomId == request.resource.data.users[1] + '_' + request.resource.data.users[0])
        && !exists(blockPath(request.resource.data.users[0], request.resource.data.users[1]))
        && !exists(blockPath(request.resource.data.users[1], request.resource.data.users[0]))
        && !request.resource.data.keys().hasAny(['messageCountBy', 'blockedBy']);

      // 更新：メンバー本人のみ。メンバー・送信数・ブロック印は変更不可。
      //       ブロック後は「非表示」と「未読数」以外は更新できない
      allow update: if isRoomMember(roomId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['users', 'messageCountBy', 'blockedBy'])
        && (resource.data.get('blockedBy', []).size() == 0
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['hiddenAt', 'unreadCount']));

      allow delete: if false;

      // ---------------- messages ----------------
      match /messages/{messageId} {
        allow read: if isRoomMember(roomId);

        // 送信者は必ず自分。ブロックされたルームには送れない
        allow create: if isRoomMember(roomId)
          && request.resource.data.senderId == request.auth.uid
          && (!existsAfter(roomPath(roomId))
              || getAfter(roomPath(roomId)).data.get('blockedBy', []).size() == 0);

        // 既読などの更新はメンバーなら可。送信者のすり替えは不可
        allow update: if isRoomMember(roomId)
          && request.resource.data.senderId == resource.data.senderId;

        // 削除は送信者本人のみ
        allow delete: if isRoomMember(roomId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    // ------------------------------------------------------------------------
    // friend_requests（友達申請）
    // ------------------------------------------------------------------------
    match /friend_requests/{requestId} {
      // 1件取得：まだ存在しない申請も確認できるようにする（トーク一覧の「申請中」表示用）
      allow get: if signedIn()
        && (resource == null
            || resource.data.toId == request.auth.uid
            || resource.data.fromId == request.auth.uid);
      // 一覧取得：自分宛ての申請だけ
      allow list: if signedIn() && resource.data.toId == request.auth.uid;

      // 申請の送信・承認は Cloud Functions のみ
      allow create, update: if false;

      // 受信者は拒否、送信者は取り消しができる
      allow delete: if signedIn()
        && (resource.data.toId == request.auth.uid
            || resource.data.fromId == request.auth.uid);
    }

    // ------------------------------------------------------------------------
    // reports（通報）
    // ------------------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterId', 'reportedId', 'reason', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedId is string
        && request.resource.data.reportedId != request.auth.uid
        && reportId == request.auth.uid + '_' + request.resource.data.reportedId
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------------
    // admin_messages（運営からのお知らせ）
    // ------------------------------------------------------------------------
    match /admin_messages/{messageId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------------
    // opinions（ご意見）＋ rate_limits（60秒に1回の連投制限）
    // ------------------------------------------------------------------------
    match /opinions/{opinionId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'text', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/rate_limits/$(request.auth.uid))
             .data.lastOpinionAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /rate_limits/{uid} {
      allow read: if false;
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['lastOpinionAt'])
        && request.resource.data.lastOpinionAt == request.time
        && (resource == null
            || request.time > resource.data.lastOpinionAt + duration.value(60, 's'));
    }

    // invite_codes / invite_owners は Cloud Functions のみが読み書きする。
    // ルールに記載しない＝クライアントからは一切アクセスできない
  }
}